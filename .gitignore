# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Run artifacts - regenerable, and noisy in diffs
failures.log
.batch_id
_probe.json
cards/*.tmp

# out/ holds the deliverables, so it is deliberately NOT ignored:
#   flashcards.html  - the app (also what GitHub Pages would serve)
#   groups.md        - the 655 group write-ups
#   group_NN.md      - the 38 GregMat groups, card by card
# All are regenerable from cards/ and groups/, but they are the things actually
# read and pasted into Slite, so they belong in the repo.
#
# all.md is the only exception: a single-file duplicate of the group_NN files.
out/all.md

# Personal study progress. Difficulty marks live in browser localStorage and are
# exported here; they are yours, not part of the project.
difficulty.json

# Source spreadsheet - GregMat's paid product, kept out of version control.
*.xlsx

# Group write-ups are regenerable from cards/ via group.py
groups/*.tmp
